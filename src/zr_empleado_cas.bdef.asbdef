managed;
strict ( 2 );
with draft;

define behavior for ZR_EMPLEADO_CAS alias Empleado
implementation in class zbp_r_empleado_cas unique
persistent table zempleado_cas_a
draft table zempleado_cas_d
lock master
total etag LocalChangedAt
authorization master ( instance )
etag master ChangedAt
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly, numbering : managed ) EmployeeUuid;
  field ( readonly ) CreatedAt, ChangedAt, LocalChangedAt;
  field ( mandatory ) Name;

  validation validateMandatory on save { field Name; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare { validation validateMandatory; }

  mapping for zempleado_cas_a
    {
      EmployeeUuid   = employee_uuid;
      Name           = name;
      Department     = department;
      ManagerId      = manager_id;
      Status         = status;
      CreatedAt      = created_at;
      ChangedAt      = changed_at;
      LocalChangedAt = local_changed_at;
    }
}